        <mxCell id="imu" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E7F7F3;strokeColor=#16846C;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="MPU-6050  •  IMU (0x68)&#xa;Uno A4 SDA / A5 SCL via 5V↔3.3V I²C shifter&#xa;Sensor VCC: 3.3 V (if breakout supports)&#xa;GND common; verify module and pull-ups" vertex="1">
