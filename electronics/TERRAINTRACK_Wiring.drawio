  <diagram name="2 — Power and Checks" id="lcqz8TLfxRyGPRkupkrz">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1285" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="power_title" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#17324D;strokeColor=#17324D;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=25;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="TERRAINTRACK  /  POWER + PROTECTION&#xa;Power distribution aligned to the current BOM • regulated voltage and peak current NOT verified" vertex="1">
          <mxGeometry height="90" width="1510" x="45" y="35" as="geometry" />
        </mxCell>
        <mxCell id="battery" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF4DC;strokeColor=#D69423;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="2S RC BATTERY&#xa;7.4 V nominal / 8.4 V full&#xa;+ battery → fuse → switch&#xa;− battery → COMMON GND&#xa;Connector polarity must be verified" vertex="1">
          <mxGeometry height="176" width="350" x="62" y="198" as="geometry" />
        </mxCell>
        <mxCell id="protection" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF0EC;strokeColor=#B85B46;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="FUSE + SWITCH&#xa;Place fuse near battery +&#xa;Choose fuse &amp; wire rating from&#xa;measured current (not yet tested)" vertex="1">
          <mxGeometry height="145" width="260" x="473" y="213" as="geometry" />
        </mxCell>
        <mxCell id="vbat" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F2F5F8;strokeColor=#708399;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="SWITCHED VBAT BUS&#xa;VBAT_SW = switched battery +&#xa;GND = common battery return&#xa;Parallel supply branches" vertex="1">
          <mxGeometry height="146" width="304" x="796" y="211" as="geometry" />
        </mxCell>
        <mxCell id="motor_supply" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF4DC;strokeColor=#D69423;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="BTS7960 MOTOR POWER&#xa;B+ ← VBAT_SW&#xa;B− ← COMMON GND&#xa;M+ / M− → brushed motor&#xa;Verify driver and motor stall current" vertex="1">
          <mxGeometry height="157" width="360" x="1173" y="210" as="geometry" />
        </mxCell>
        <mxCell id="reg5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF3FF;strokeColor=#386DB0;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="5 V REGULATOR / UBEC&#xa;Input: VBAT_SW / GND&#xa;Output: +5V / common GND&#xa;Single regulator listed in BOM&#xa;Servo + logic peak load: CHECK FIRST" vertex="1">
          <mxGeometry height="165" width="451" x="219" y="556" as="geometry" />
        </mxCell>
        <mxCell id="reg33" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E7F7F3;strokeColor=#16846C;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="3.3 V REGULATOR&#xa;Input: VBAT_SW / GND&#xa;Output: +3.3V / common GND&#xa;Adjust / measure output BEFORE LiDAR&#xa;Never power TFS20-L with 5 V" vertex="1">
          <mxGeometry height="166" width="440" x="886" y="556" as="geometry" />
        </mxCell>
        <mxCell id="users5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF3FF;strokeColor=#386DB0;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="5 V CONSUMERS  •  CHECK CAPACITY&#xa;Arduino Uno regulated +5V input; BTS7960 VCC&#xa;Steering/pan/tilt servos (high current spikes)&#xa;ESP32 board: ONLY through supported 5 V/VBUS input&#xa;Do NOT tie two separate buck + outputs together" vertex="1">
          <mxGeometry height="165" width="585" x="99" y="855" as="geometry" />
        </mxCell>
        <mxCell id="users33" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E7F7F3;strokeColor=#16846C;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="3.3 V CONSUMERS / LOGIC&#xa;TFS20-L: pins 1 + 2 → +3.3 V; pin 6 → GND&#xa;MPU-6050: verify breakout VCC &amp; I²C level requirements&#xa;UART level shift on Uno TX 5 V → ESP32 RX 3.3 V&#xa;LiDAR TX/RX direct to ESP32 3.3 V UART" vertex="1">
          <mxGeometry height="165" width="599" x="900" y="855" as="geometry" />
        </mxCell>
        <mxCell id="common" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F2F5F8;strokeColor=#708399;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="COMMON GROUND  /  CONNECTION CHECKS&#xa;Battery −, Arduino GND, ESP32 GND, both regulators GND, BTS7960 GND, servos GND, sensors GND must share reference.&#xa;Avoid powering Uno 5 V pin and USB at the same time without assessing backfeed. Add bulk capacitor close to servos; validate actual load and wiring." vertex="1">
          <mxGeometry height="119" width="1460" x="75" y="1109" as="geometry" />
        </mxCell>
