          <mxGeometry height="158" width="340" x="60" y="175" as="geometry" />
        </mxCell>
        <mxCell id="esp" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E7F7F3;strokeColor=#16846C;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="ESP32-S3  •  CAMERA + WIFI&#xa;Camera GPIO map: board-specific, UNVERIFIED&#xa;Uno UART: GPIO41 RX / GPIO42 TX&#xa;LiDAR UART: GPIO1 RX / GPIO2 TX&#xa;Both UART links: 115200 baud" vertex="1">
          <mxGeometry height="219" width="460" x="545" y="165" as="geometry" />
        </mxCell>
        <mxCell id="lidar" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E7F7F3;strokeColor=#16846C;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="TFS20-L  •  3.3 V ONLY&#xa;Pin 1 + Pin 2: regulated +3.3V&#xa;Pin 3 TX  →  ESP32 GPIO1 RX&#xa;Pin 4 RX  ←  ESP32 GPIO2 TX&#xa;Pin 5 GND: selects UART mode&#xa;Pin 6: GND" vertex="1">
          <mxGeometry height="220" width="386" x="1160" y="166" as="geometry" />
        </mxCell>
        <mxCell id="bts" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF4DC;strokeColor=#D69423;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="BTS7960  •  H-BRIDGE&#xa;RPWM ← Uno D5&#xa;LPWM ← Uno D6&#xa;R_EN ← Uno D7&#xa;L_EN ← Uno D8&#xa;VCC: +5V; motor supply: VBAT" vertex="1">
          <mxGeometry height="190" width="370" x="60" y="565" as="geometry" />
        </mxCell>
        <mxCell id="uno" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF3FF;strokeColor=#386DB0;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="ARDUINO UNO R3  •  CONTROL&#xa;Serial: D0 RX ← ESP GPIO42 TX&#xa;Serial: D1 TX → ESP GPIO41 RX*&#xa;Drive: D5, D6, D7, D8&#xa;Servos: D9 steer / D10 pan / D11 tilt&#xa;Encoder inputs: D2 left / D3 right&#xa;IMU I²C: A4 SDA / A5 SCL" vertex="1">
          <mxGeometry height="273" width="460" x="545" y="536" as="geometry" />
        </mxCell>
        <mxCell id="servos" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF4DC;strokeColor=#D69423;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="SERVOS  •  5 V RAIL&#xa;Steering signal  ←  Uno D9&#xa;Gimbal pan signal  ←  Uno D10&#xa;Gimbal tilt signal  ←  Uno D11&#xa;All V+: regulated 5V; all GND: common&#xa;Confirm servo current and mechanical travel" vertex="1">
          <mxGeometry height="204" width="435" x="1112" y="548" as="geometry" />
        </mxCell>
        <mxCell id="motor" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F2F5F8;strokeColor=#708399;strokeWidth=2;fontColor=#1F3445;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=10;spacingTop=8;spacingBottom=7;" value="BRUSHED DRIVE MOTOR&#xa;BTS7960 M+ / M−  →  motor leads&#xa;Battery 7.4 V nominal, 8.4 V fully charged" vertex="1">
          <mxGeometry height="116" width="365" x="65" y="857" as="geometry" />
